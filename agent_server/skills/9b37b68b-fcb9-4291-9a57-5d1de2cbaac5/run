def run_phaser(script_text: str, logf) -> int:
    logf.write(f"# phenix.phaser script:\n{script_text}\n")
    logf.write("# --- begin phaser ---\n")
    logf.flush()
    proc = subprocess.run(
        [str(phaser_bin)],
        input=script_text,
        stdout=logf,
        stderr=subprocess.STDOUT,
        text=True,
        cwd=str(work),
    )
    return proc.returncode


