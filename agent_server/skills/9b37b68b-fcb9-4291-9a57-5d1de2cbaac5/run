def _prefer_solution(names: list[str], suffix: str) -> Optional[str]:
    """Prefer numbered solution files (phaser_mr.1.*) over unnumbered."""
    matches = [n for n in names if n.endswith(suffix)]
    if not matches:
        return None
    numbered = sorted(
        matches,
        key=lambda n: (
            0 if re.search(r"\.\d+\." + re.escape(suffix.lstrip(".")), n) else 1,
            n,
        ),
    )
    return numbered[0]


solution_pdb_name = _prefer_solution(copied_products, ".pdb")
solution_mtz_name = _prefer_solution(copied_products, ".mtz")

