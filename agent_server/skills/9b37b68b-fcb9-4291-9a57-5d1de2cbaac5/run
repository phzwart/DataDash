# Density maps for Mol* — prefer Phaser MTZ coeffs; else phenix.maps(model + data).
density_map: Optional[str] = None
density_maps: list[str] = []
map_note: Optional[str] = None
denmod_mtz_rel: Optional[str] = None


def _collect_map_files(src_dir: Path) -> None:
    global density_map
    for p in sorted(src_dir.rglob("*")):
        if not p.is_file():
            continue
        if p.suffix.lower() not in {".ccp4", ".map"}:
            continue
        dest_name = f"density_{p.name}"
        dest = data / dest_name
        if not dest.exists():
            shutil.copy2(p, dest)
        rel = f"data/{dest_name}"
        if rel not in density_maps:
            density_maps.append(rel)
    for candidate in density_maps:
        low = candidate.lower()
        if "2fofc" in low or "2mfo" in low or "fwt" in low:
            density_map = candidate
            break
    if density_maps and density_map is None:
        density_map = density_maps[0]


if solution_pdb_name and phaser_rc == 0:
    progress("computing density maps", 90)
    map_work = work / "maps"
    map_work.mkdir(parents=True, exist_ok=True)

    # 1) FFT Phaser map coefficients when present
    if solution_mtz_name:
        mtz2map = phenix / "phenix_bin" / "phenix.mtz2map"
        if mtz2map.is_file():
            map_log = work / "mtz2map.log"
            with map_log.open("w", encoding="utf-8") as logf:
                map_proc = subprocess.run(
                    [
                        str(mtz2map),
                        f"mtz_file={data / solution_mtz_name}",
                        f"pdb_file={data / solution_pdb_name}",
                        f"output.directory={map_work}",
                        "output.format=ccp4",
                    ],
                    stdout=logf,
                    stderr=subprocess.STDOUT,
                    text=True,
                    cwd=str(map_work),
                )
            if map_proc.returncode != 0:
                print(
                    f"phenix.mtz2map exited {map_proc.returncode} (non-fatal)",
                    file=sys.stderr,
                )
            _collect_map_files(map_work)
            if density_maps:
                map_note = "from Phaser MTZ coefficients (phenix.mtz2map)"

    # 2) Fallback: phenix.maps from placed PDB + experimental F/SIGF MTZ
    if not density_maps:
        maps_bin = phenix / "phenix_bin" / "phenix.maps"
        if maps_bin.is_file():
            maps_log = work / "phenix_maps.log"
            with maps_log.open("w", encoding="utf-8") as logf:
                maps_proc = subprocess.run(
                    [
                        str(maps_bin),
                        str(data / solution_pdb_name),
                        str(mtz_path),
                    ],
                    stdout=logf,
                    stderr=subprocess.STDOUT,
                    text=True,
                    cwd=str(map_work),
                )
            if maps_proc.returncode != 0:
                print(
                    f"phenix.maps exited {maps_proc.returncode} (non-fatal); "
                    f"see {maps_log}",
                    file=sys.stderr,
                )
            _collect_map_files(map_work)
            if density_maps:
                map_note = "from phenix.maps (placed model + experimental MTZ)"

    if density_maps:
        print(f"Density maps: {', '.join(density_maps)} ({map_note})", file=sys.stderr)
    else:
        print("No density maps produced", file=sys.stderr)

    # 3) RESOLVE density modification — solvent from Phaser Matthews (authoritative)
    densmod_on = True
    _raw_dm = params.get("density_modify", True)
    if isinstance(_raw_dm, str):
        densmod_on = _raw_dm.strip().lower() in {"1", "true", "yes", "on"}
    else:
        densmod_on = bool(_raw_dm)

    if densmod_on and solution_pdb_name:
        progress("RESOLVE density modification", 92)
        dm_dir = work / "densmod"
        dm_dir.mkdir(parents=True, exist_ok=True)

        solvent_f = matthews_analysis.get("solvent_fraction") or matthews.get(
            "solvent_fraction"
        )
        # Explicit user override wins; else Phaser Matthews CCA; else 0.5.
        user_solvent = params.get("solvent_content")
        if user_solvent is not None:
            try:
                solvent_f = float(user_solvent)
            except (TypeError, ValueError):
                pass
        if solvent_f is None or not (0.05 < float(solvent_f) < 0.95):
            solvent_f = 0.5
        solvent_f = float(solvent_f)

        densmod_bin = phenix / "phenix_bin" / "phenix.density_modification"
        dm_log = work / "densmod.log"
        denmod_mtz_path = dm_dir / "denmod.mtz"
        if densmod_bin.is_file():
            dm_cmd = [
                str(densmod_bin),
                f"pdb_file={data / solution_pdb_name}",
                f"data_file={mtz_path}",
                "data_labels=F,SIGF",
                f"denmod.solvent_content={solvent_f:.4f}",
                f"output_files.output_mtz={denmod_mtz_path}",
            ]
            # Prefer Phaser map coefficients (FWT/PHWT) as densmod starting phases.
            if solution_mtz_name:
                dm_cmd.extend(
                    [
                        f"map_coeffs_file={data / solution_mtz_name}",
                        "map_coeffs_labels=FWT,PHWT",
                    ]
                )
            with dm_log.open("w", encoding="utf-8") as logf:
                dm_proc = subprocess.run(
                    dm_cmd,
                    stdout=logf,
                    stderr=subprocess.STDOUT,
                    text=True,
                    cwd=str(dm_dir),
                )
            if dm_proc.returncode != 0:
                print(
                    f"phenix.density_modification exited {dm_proc.returncode} "
                    f"(non-fatal); see {dm_log}",
                    file=sys.stderr,
                )
            else:
                print(
                    f"Density modification OK "
                    f"(Matthews solvent={solvent_f:.4f})",
                    file=sys.stderr,
                )

        if denmod_mtz_path.is_file():
            shutil.copy2(denmod_mtz_path, data / "denmod.mtz")
            denmod_mtz_rel = "data/denmod.mtz"
            mtz2map = phenix / "phenix_bin" / "phenix.mtz2map"
            if mtz2map.is_file():
                with (work / "mtz2map_denmod.log").open("w", encoding="utf-8") as logf:
                    subprocess.run(
                        [
                            str(mtz2map),
                            f"mtz_file={denmod_mtz_path}",
                            f"pdb_file={data / solution_pdb_name}",
                            f"output.directory={dm_dir}",
                            "output.format=ccp4",
                        ],
                        stdout=logf,
                        stderr=subprocess.STDOUT,
                        text=True,
                        cwd=str(dm_dir),
                    )
            before = set(density_maps)
            _collect_map_files(dm_dir)
            new_maps = [m for m in density_maps if m not in before]
            if new_maps:
                density_map = new_maps[0]
                for candidate in new_maps:
                    low = candidate.lower()
                    if "2fofc" in low or "2mfo" in low or "fwt" in low:
                        density_map = candidate
                        break
                map_note = (
                    "RESOLVE density modification "
                    f"(phenix.density_modification, "
                    f"Matthews solvent={solvent_f:.4f})"
                )
                print(f"Densmod maps: {', '.join(new_maps)}", file=sys.stderr)

summary = {
