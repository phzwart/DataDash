def build_phaser_script(*, root: str, pack_line: Optional[str] = None) -> str:
    lines = [
        "MODE MR_AUTO",
        f"HKLIN {mtz_path}",
        f"LABIN {labin}",
        f"ENSEMBLE model PDBFILE {bare} IDENTITY {ident_pct:.1f}",
        f"COMPOSITION PROTEIN SEQUENCE_FILE {fasta} NUMBER {copies}",
        f"SEARCH ENSEMBLE model NUM {copies}",
        f"RESOLUTION 50.0 {high_res}",
        tncs_keyword,
    ]
    if pack_line:
        lines.append(pack_line)
    lines.append(f"ROOT {root}")
    lines.append("")
    return "\n".join(lines)


