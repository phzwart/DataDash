# Local Tiled client store (hydrated crates) — run client_store/serve.sh
VITE_TILED_API_URL=http://127.0.0.1:8770/api/v1
VITE_TILED_API_KEY=secret

# Remote facility server (search + pull source)
VITE_FACILITY_API_URL=http://127.0.0.1:8767

# Hydrate API (defaults to local Tiled origin if unset)
# VITE_HYDRATE_API_URL=http://127.0.0.1:8770

# Agent orchestration server (skills / jobs)
VITE_AGENT_API_URL=http://127.0.0.1:8780

# Optional: dashboard YAML (served from local client_store schemas/)
# VITE_DASHBOARD_URI=http://127.0.0.1:8770/schemas/lambda_mx_dashboard.yaml
